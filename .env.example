# ==============================================================================
# PrintEasy — Environment Configuration Example
# ==============================================================================

# Application
PROJECT_NAME="PrintEasy"
DEBUG=false

# Security & Authentication (Replace in production with a 64+ char random string)
SECRET_KEY="generate-a-strong-random-secret-key-for-jwt-signing"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Argon2id Password Hashing Parameters
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4

# Database Connections
# For local development with SQLite:
DATABASE_URL="sqlite:///./storage/printeasy.db"

# For Docker / Production with PostgreSQL:
# DATABASE_URL="postgresql://printeasy:printeasy_secure_pass_123@postgres:5432/printeasy"

# PostgreSQL Container Credentials (used by docker-compose)
POSTGRES_USER=printeasy
POSTGRES_PASSWORD=printeasy_secure_pass_123
POSTGRES_DB=printeasy

# Document Storage & Limits
STORAGE_DIR="./storage/private"
MAX_FILE_SIZE_BYTES=10485760 # 10 MB

# Frontend CORS Allowed Origins
CORS_ORIGINS=["http://localhost", "http://localhost:80", "http://localhost:5173", "http://127.0.0.1:5173"]
